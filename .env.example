# Comma-separated Discord bot tokens, one per Speaker. The first is the Primary Speaker.
# A single legacy TOKEN is still accepted.
# TOKENS=
# Application id of the Primary Speaker (used to register slash commands)
# PRIMARY_DISCORD_APP_ID=

# --- Text-to-speech ---
# Provider: google-cloud (default, needs credentials) | translate (no credentials)
# TTS_PROVIDER=google-cloud
# Default language: th (default) | en
# TTS_DEFAULT_LANG=th

# --- Google Cloud (required when TTS_PROVIDER=google-cloud) ---
# Voice names. The voice name selects the model tier (Standard, Neural2, Chirp3-HD...).
TTS_VOICE_TH=th-TH-Standard-A
TTS_VOICE_EN=en-US-Standard-C
# Path to a service-account JSON key file.
#   Docker/Compose: this must be the path INSIDE the container, not on the host.
#   docker-compose.yml already mounts ./secrets/gcp-tts.json there and sets it.
#   Local (pnpm dev): use a host path, e.g. ./secrets/gcp-tts.json
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-tts.json
